generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  createdAt    DateTime     @default(now())
  password     String?
  providerId   String?
  refreshToken String?
  updatedAt    DateTime     @updatedAt
  username     String       @unique
  provider     AuthProvider @default(CREDENTIALS)
  otp          String?
  otpvalidity  DateTime?
  files        File[]
  Signature    Signature[]
  sharedLinks  sharedLink[]
}

model File {
  id          String       @id @default(cuid())
  fileurl     String
  publicid    String
  userId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  signature   Signature[]
  sharedLinks sharedLink[]
  filename    String
  user        User?        @relation(fields: [userId], references: [id])
}

model Signature {
  id           String   @id @default(cuid())
  // Signature  image
  signatureUrl String
  // Placement  metadata
  page         Int
  x            Float
  y            Float
  width        Float
  height       Float
  // Relations
  userId       String?
  pdfId        String
  User         User?    @relation(fields: [userId], references: [id])
  Pdf          File     @relation(fields: [pdfId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AuthProvider {
  GOOGLE
  CREDENTIALS
}

model sharedLink {
  id         String   @id @default(cuid())
  link       String   @unique
  fileId     String
  file       File     @relation(fields: [fileId], references: [id])
  sharedbyId String?
  user       User?    @relation(fields: [sharedbyId], references: [id])
  sharedWith String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
